accordionRightMusic = \relative c'' {
  % Bars 1–4
  <c e>2 <b d>2 |
  <a c>2 <b d>2 |
  <g c>2 <g b>2 |
  <g b>2 r2 |
  % Bars 5–8
  <g c>2 <b e>2 |
  <a c>2 <g c>2 |
  <a d>2 <g b>2 |
  <g c>1\bar "|."
}

accordionLeftMusic = \relative c {
  % Bars 1–4
  c2 g |
  f2 c |
  c2 g |
  g2 r2 |
  % Bars 5–8
  c2 g |
  f2 c |
  g2 g |
  c1\bar "|."
}
